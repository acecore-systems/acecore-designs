---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {
  catalogs,
  ui,
  serializeJsonForHtml,
  type Locale,
} from '../data/catalog'
import {
  htmlLangMap,
  ogLocaleMap,
  locales,
  localePath,
} from '../data/locales.mjs'
import '../styles/global.css'

interface Props {
  locale: Locale
  title?: string
  description?: string
  jsonLd?: Record<string, unknown>
  isErrorPage?: boolean
}
const { locale, title, description, jsonLd, isErrorPage = false } = Astro.props
const copy = catalogs[locale]
const pageTitle = title ?? `${copy.title} | ${copy.seoTitleContext}`
const pageDescription = description ?? copy.description
const canonical = new URL(localePath(locale), Astro.site).href
const image = new URL('/uploads/og-default.png', Astro.site).href
const organization = {
  '@type': 'Organization',
  '@id': 'https://acecore.net/#organization',
  name: 'Acecore',
  legalName: '株式会社Acecore',
  url: 'https://acecore.net/',
  logo: new URL('/favicon.svg', Astro.site).href,
}
---

<!doctype html>
<html lang={htmlLangMap[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={isErrorPage ? 'noindex, follow' : 'index, follow'}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!isErrorPage && <link rel="canonical" href={canonical} />}
    {
      !isErrorPage &&
        locales.map((language) => (
          <link
            rel="alternate"
            hreflang={htmlLangMap[language]}
            href={new URL(localePath(language), Astro.site).href}
          />
        ))
    }
    {
      !isErrorPage && (
        <link rel="alternate" hreflang="x-default" href={Astro.site} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Acecore Designs" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {!isErrorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Acecore" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Acecore" />
    {
      !isErrorPage && (
        <script
          type="application/ld+json"
          set:html={serializeJsonForHtml({
            '@context': 'https://schema.org',
            '@graph': [
              organization,
              {
                '@type': 'WebSite',
                '@id': 'https://designs.acecore.net/#website',
                name: 'Acecore Designs',
                url: 'https://designs.acecore.net/',
                publisher: { '@id': organization['@id'] },
                inLanguage: htmlLangMap[locale],
              },
              ...(jsonLd ? [jsonLd] : []),
            ],
          })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-800">
    <a href="#main" class="skip-link">{ui[locale].skipToContent}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1" class="flex-1"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
