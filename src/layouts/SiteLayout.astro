---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {
  catalogs,
  ui,
  serializeJsonForHtml,
  type Locale,
} from '../data/catalog'
import { htmlLangMap, ogLocaleMap, locales } from '../data/locales.mjs'
import { groupIds, routePath } from '../data/routes.mjs'
import '../styles/global.css'
import '../styles/brand.css'

interface Props {
  locale: Locale
  route?: string
  title?: string
  description?: string
  jsonLd?: Record<string, unknown>
  isErrorPage?: boolean
}
const {
  locale,
  route = 'home',
  title,
  description,
  jsonLd,
  isErrorPage = false,
} = Astro.props
const copy = catalogs[locale]
const pageTitle = title ?? `${copy.title} | ${copy.seoTitleContext}`
const pageDescription = description ?? copy.description
const canonical = new URL(routePath(locale, route), Astro.site).href
const routeTitle =
  copy.groups.find((group) => group.id === route)?.title ??
  ui[locale].site.nav[route] ??
  copy.title
const crumbs = [
  { name: ui[locale].home, item: new URL(routePath(locale), Astro.site).href },
]
if (groupIds.includes(route))
  crumbs.push({
    name: ui[locale].site.nav.services,
    item: new URL(routePath(locale, 'services'), Astro.site).href,
  })
crumbs.push({ name: routeTitle, item: canonical })
const image = new URL('/uploads/og-default.png', Astro.site).href
const organization = {
  '@type': 'Organization',
  '@id': 'https://acecore.net/#organization',
  name: 'Acecore',
  legalName: '株式会社Acecore',
  url: 'https://acecore.net/',
  logo: new URL('/favicon.svg', Astro.site).href,
}
---

<!doctype html>
<html lang={htmlLangMap[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={isErrorPage ? 'noindex, follow' : 'index, follow'}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!isErrorPage && <link rel="canonical" href={canonical} />}
    {
      !isErrorPage &&
        locales.map((language) => (
          <link
            rel="alternate"
            hreflang={htmlLangMap[language]}
            href={new URL(routePath(language, route), Astro.site).href}
          />
        ))
    }
    {
      !isErrorPage && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(routePath('ja', route), Astro.site).href}
        />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Acecore Designs" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {!isErrorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Acecore" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Acecore" />
    {
      !isErrorPage && (
        <script
          type="application/ld+json"
          set:html={serializeJsonForHtml({
            '@context': 'https://schema.org',
            '@graph': [
              organization,
              {
                '@type': 'WebSite',
                '@id': 'https://designs.acecore.net/#website',
                name: 'Acecore Designs',
                url: 'https://designs.acecore.net/',
                publisher: { '@id': organization['@id'] },
                inLanguage: htmlLangMap[locale],
              },
              {
                '@type': 'WebPage',
                '@id': `${canonical}#webpage`,
                url: canonical,
                name: pageTitle,
                description: pageDescription,
                inLanguage: htmlLangMap[locale],
                isPartOf: { '@id': 'https://designs.acecore.net/#website' },
              },
              ...(route !== 'home'
                ? [
                    {
                      '@type': 'BreadcrumbList',
                      itemListElement: crumbs.map((crumb, index) => ({
                        '@type': 'ListItem',
                        position: index + 1,
                        ...crumb,
                      })),
                    },
                  ]
                : []),
              ...(jsonLd ? [jsonLd] : []),
            ],
          })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-800">
    <a href="#main" class="skip-link">{ui[locale].skipToContent}</a>
    <Header locale={locale} route={route} />
    <main id="main" tabindex="-1" class="flex-1"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
