---
import { catalogs, ui, type Locale } from '../data/catalog'
import { portfolioWorks } from '../data/portfolio.mjs'
import { inquiryUrl } from '../data/locales.mjs'
import { routePath, servicePath } from '../data/routes.mjs'
import Arrow from './Arrow.astro'

interface Props {
  locale: Locale
  variant?: 'full' | 'summary'
  groupId?: string
  featured?: boolean
  showHeading?: boolean
}
const {
  locale,
  variant = 'full',
  groupId,
  featured = false,
  showHeading = true,
} = Astro.props
const copy = catalogs[locale]
const labels = ui[locale].portfolio
const services = new Map(
  copy.groups
    .flatMap((group) => group.services)
    .map((service) => [service.id, service]),
)
const group = copy.groups.find((group) => group.id === groupId)
const works = featured
  ? portfolioWorks.filter((work) =>
      ['desert-sketch', 'moku', 'bright-friend'].includes(work.id),
    )
  : group
    ? portfolioWorks.filter((work) =>
        work.services.some((id) =>
          group.services.some((service) => service.id === id),
        ),
      )
    : portfolioWorks
const CardHeading = showHeading ? 'h3' : 'h2'
const sectionId = variant === 'full' ? 'works' : 'related-works'
---

{variant === 'full' && <span id="creator" class="block" aria-hidden="true" />}
<section
  id={sectionId}
  class="ac-section bg-white"
  aria-labelledby={showHeading ? 'works-heading' : 'page-heading'}
>
  <div class="ac-container">
    {
      showHeading && (
        <div class="portfolio-heading">
          <div class="max-w-3xl">
            <p class="portfolio-eyebrow">Acecore Designs</p>
            <h2 id="works-heading" class="ac-heading text-2xl sm:text-4xl">
              {labels.title}
            </h2>
            <p class="ac-muted mt-4">{labels.intro}</p>
          </div>
          <a href={routePath(locale, 'works')} class="text-link">
            {labels.viewWorks}
            <Arrow />
          </a>
        </div>
      )
    }
    <div class="portfolio-grid">
      {
        works.map((work, index) => {
          const text = labels.works[work.id]
          return (
            <article
              id={`work-${work.id}`}
              class="ac-card portfolio-card"
              data-portfolio-work={work.id}
            >
              {work.image ? (
                <div class="portfolio-image">
                  <img
                    src={work.image.src}
                    width={work.image.width}
                    height={work.image.height}
                    alt={text.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div
                  class={`portfolio-text-preview portfolio-text-preview--${work.kind}`}
                  aria-hidden="true"
                >
                  {work.kind === 'writing' ? (
                    <svg
                      width="48"
                      height="48"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                    >
                      <path d="M12 5c-3-2-7-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1ZM12 5v15" />
                    </svg>
                  ) : (
                    <svg
                      width="64"
                      height="48"
                      viewBox="0 0 32 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    >
                      <path d="M2 10v4M7 6v12M12 2v20M17 7v10M22 4v16M27 8v8M32 11v2" />
                    </svg>
                  )}
                  <span>{text.title}</span>
                  <span class="portfolio-preview-credit">{text.credit}</span>
                </div>
              )}
              <div class="portfolio-card-body">
                <p class="portfolio-kind">
                  <span aria-hidden="true">0{index + 1} / </span>
                  {labels.kinds[work.kind]}
                </p>
                <CardHeading class="text-lg font-800 leading-snug text-brand-950">
                  {text.title}
                </CardHeading>
                {variant === 'full' ? (
                  <>
                    <dl class="portfolio-case-details">
                      <div>
                        <dt>{labels.productionLabel}</dt>
                        <dd class="ac-muted">{text.description}</dd>
                      </div>
                      <div class="portfolio-deliverable">
                        <dt>{labels.deliverableLabel}</dt>
                        <dd class="ac-muted">{text.deliverable}</dd>
                      </div>
                    </dl>
                    <p class="portfolio-credit">{text.credit}</p>
                    <div class="portfolio-services">
                      <p>{labels.relatedServices}</p>
                      <ul>
                        {work.services.map((id) => (
                          <li>
                            <a
                              href={servicePath(locale, copy, id)}
                              data-work-service={id}
                            >
                              {services.get(id)!.title}
                              <Arrow />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                ) : (
                  <>
                    <p class="ac-muted mt-3 text-sm">{text.description}</p>
                    <p class="portfolio-deliverable ac-muted mt-4 text-sm">
                      {text.deliverable}
                    </p>
                    <p class="portfolio-credit">{text.credit}</p>
                    <a
                      class="text-link mt-auto pt-4"
                      href={`${routePath(locale, 'works')}#work-${work.id}`}
                    >
                      {ui[locale].site.viewDetails}
                      <Arrow />
                    </a>
                  </>
                )}
                <a
                  href={inquiryUrl(locale, work.offering)}
                  class="ac-btn-primary mt-4 gap-3"
                  data-work-inquiry={work.id}
                  aria-label={`${text.title} — ${labels.consultThisWork}`}
                >
                  {labels.consultThisWork}
                  <Arrow />
                </a>
                <div class="portfolio-source-links">
                  <a
                    href={work.sourceUrl}
                    aria-label={`${text.title} — ${labels.viewSource}`}
                  >
                    {labels.viewSource}
                    <Arrow />
                  </a>
                  {work.workUrl && (
                    <a
                      href={work.workUrl}
                      aria-label={`${text.title} — ${labels.actions[work.action]}`}
                    >
                      {labels.actions[work.action]}
                      <Arrow />
                    </a>
                  )}
                </div>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
