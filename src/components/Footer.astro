---
import { catalogs, ui, type Locale } from '../data/catalog'
import { corporateUrl, inquiryUrl, localePath } from '../data/locales.mjs'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = catalogs[locale]
const labels = ui[locale]
---

<footer
  class="border-t border-slate-200 bg-slate-50 py-10 text-sm text-slate-600"
>
  <div class="ac-container">
    <div class="flex flex-col justify-between gap-7 lg:flex-row">
      <div>
        <a
          href={localePath(locale)}
          class="text-base font-800 text-brand-950 no-underline"
          >Acecore / Designs</a
        >
        <p class="mt-3">{labels.company}</p>
      </div>
      <nav
        class="flex max-w-2xl flex-wrap gap-x-6 gap-y-2"
        aria-label={labels.company}
      >
        <a class="footer-link" href={corporateUrl(locale, 'about/')}
          >{labels.about}</a
        >
        <a class="footer-link" href={inquiryUrl(locale)}>{labels.contact}</a>
        <a
          class="footer-link"
          href="https://schools.acecore.net/learning/#creative-services"
          >Acecore Schools</a
        >
        <a class="footer-link" href="https://hatt.acecore.net/"
          >{copy.portfolioLabel}</a
        >
        <a class="footer-link" href={corporateUrl(locale, 'privacy/')}
          >{labels.privacy}</a
        >
      </nav>
    </div>
    <p class="mt-8 border-t border-slate-200 pt-6 text-xs">
      © {new Date().getUTCFullYear()}
      {labels.company}
    </p>
  </div>
</footer>
