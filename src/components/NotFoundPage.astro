---
import SiteLayout from '../layouts/SiteLayout.astro'
import { ui, type Locale } from '../data/catalog'
import { localePath } from '../data/locales.mjs'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = ui[locale].notFound
---

<SiteLayout
  locale={locale}
  title={`${copy.title} | Acecore Designs`}
  description={copy.description}
  isErrorPage
>
  <section class="ac-section bg-slate-50">
    <div class="ac-container">
      <p class="text-sm font-800 text-brand-600">404</p>
      <h1 class="ac-heading mt-3 text-3xl sm:text-4xl">{copy.heading}</h1>
      <p class="ac-muted mt-5">{copy.body}</p>
      <a href={localePath(locale)} class="ac-btn-primary mt-7">{copy.goHome}</a>
    </div>
  </section>
</SiteLayout>
