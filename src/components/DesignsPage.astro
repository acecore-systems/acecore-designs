---
import SiteLayout from '../layouts/SiteLayout.astro'
import { catalogs, ui, type Locale } from '../data/catalog'
import { inquiryUrl } from '../data/locales.mjs'
import { routePath } from '../data/routes.mjs'
import { homeHeroWork, portfolioWorks } from '../data/portfolio.mjs'
import Arrow from './Arrow.astro'
import PageHeading from './PageHeading.astro'
import ServiceEntries from './ServiceEntries.astro'
import ServiceCatalog from './ServiceCatalog.astro'
import PurposeNavigation from './PurposeNavigation.astro'
import PortfolioSection from './PortfolioSection.astro'
import ProductionDiagram from './ProductionDiagram.astro'
import PricingTable from './PricingTable.astro'
import ProcessSections from './ProcessSections.astro'
import ContactBand from './ContactBand.astro'
import LegacyHomeLinks from './LegacyHomeLinks.astro'

interface Props {
  locale: Locale
  route?: string
}
const { locale, route = 'home' } = Astro.props
const copy = catalogs[locale]
const labels = ui[locale]
const site = labels.site
const group = copy.groups.find((group) => group.id === route)
const title = group?.title ?? (route === 'home' ? copy.title : site.nav[route])
const description = group
  ? site.groups[group.id].intro
  : route === 'home'
    ? copy.description
    : route === 'services'
      ? site.servicesIntro
      : route === 'works'
        ? labels.portfolio.intro
        : route === 'pricing'
          ? site.pricingIntro
          : copy.flowBody
const absolute = (path: string) =>
  new URL(path, 'https://designs.acecore.net').href
const pageUrl = absolute(routePath(locale, route))
const heroWork = homeHeroWork
const heroText = site.heroWork
const offerCatalog = {
  '@type': 'OfferCatalog',
  name: title,
  url: pageUrl,
  itemListElement: (group ? [group] : copy.groups).map((category) => ({
    '@type': 'OfferCatalog',
    name: category.title,
    itemListElement: category.services.map((service) => ({
      '@type': 'Offer',
      url: `${absolute(routePath(locale, category.id))}#${service.id}`,
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: service.price,
        priceCurrency: 'JPY',
        valueAddedTaxIncluded: true,
      },
      itemOffered: {
        '@type': 'Service',
        name: service.title,
        description: service.description,
        provider: { '@id': 'https://acecore.net/#organization' },
      },
    })),
  })),
}
const answers = [
  copy.conditionsBody,
  copy.flowBody,
  labels.portfolio.faqAnswer,
  copy.schoolsBody,
]
const schema =
  group || route === 'pricing'
    ? offerCatalog
    : route === 'works'
      ? {
          '@type': 'ItemList',
          name: title,
          url: pageUrl,
          itemListElement: portfolioWorks.map((work, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            item: {
              '@type': 'CreativeWork',
              name: labels.portfolio.works[work.id].title,
              url: `${pageUrl}#work-${work.id}`,
              creator: { '@type': 'Person', name: 'Hatt' },
              ...(work.image ? { image: absolute(work.image.src) } : {}),
            },
          })),
        }
      : route === 'process'
        ? {
            '@type': 'FAQPage',
            url: pageUrl,
            mainEntity: labels.guidance.questions.map((question, index) => ({
              '@type': 'Question',
              name: question,
              acceptedAnswer: { '@type': 'Answer', text: answers[index] },
            })),
          }
        : {
            '@type': 'ItemList',
            name: copy.title,
            url: pageUrl,
            itemListElement: copy.groups.map((category, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: category.title,
              url: absolute(routePath(locale, category.id)),
            })),
          }
---

<SiteLayout
  locale={locale}
  route={route}
  title={route === 'home' ? undefined : `${title} | Acecore Designs`}
  description={description}
  jsonLd={schema}
>
  {
    route === 'home' ? (
      <>
        <section class="designs-hero bg-brand-950 text-white">
          <div class="ac-container hero-layout">
            <div>
              <h1 class="hero-title">
                {locale === 'ja'
                  ? copy.heroTitle.replace('、', '、\n')
                  : copy.heroTitle}
              </h1>
              <p class="mt-6 max-w-3xl text-base leading-relaxed text-brand-100 sm:text-lg">
                {copy.heroLead}
              </p>
              <div class="hero-actions">
                <a
                  href={routePath(locale, 'services')}
                  class="ac-btn-secondary"
                >
                  {site.nav.services}
                  <Arrow />
                </a>
                <a
                  href={inquiryUrl(locale)}
                  class="ac-btn-primary hero-consult"
                >
                  {labels.guidance.consultProject}
                  <Arrow />
                </a>
              </div>
              <a class="hero-work-link" href={routePath(locale, 'works')}>
                {labels.portfolio.viewWorks}
                <Arrow />
              </a>
            </div>
            <figure class="hero-work ac-card">
              <a
                href={heroWork.sourceUrl}
                aria-label={`${heroText.title} — ${site.viewDetails}`}
              >
                <img
                  src={heroWork.image!.src}
                  width={heroWork.image!.width}
                  height={heroWork.image!.height}
                  alt={heroText.alt}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </a>
              <figcaption>
                <>
                  <span>{heroText.title}</span>
                  <span>{heroText.credit}</span>
                </>
              </figcaption>
            </figure>
          </div>
        </section>
        <section class="ac-section bg-white" aria-labelledby="services-heading">
          <div class="ac-container">
            <>
              <h2 id="services-heading" class="ac-heading text-2xl sm:text-4xl">
                {site.homeServicesTitle}
              </h2>
              <ServiceEntries locale={locale} />
            </>
          </div>
        </section>
        <PortfolioSection locale={locale} variant="summary" featured />
        <section class="ac-section bg-brand-50">
          <div class="ac-container brief-layout">
            <>
              <div>
                <>
                  <h2 class="ac-heading text-2xl">{site.nav.pricing}</h2>
                  <p class="ac-muted mt-4">{copy.conditionsBody}</p>
                </>
              </div>
              <div class="flex items-center">
                <a
                  class="ac-btn-outline gap-3"
                  href={routePath(locale, 'pricing')}
                >
                  {site.nav.pricing}
                  <Arrow />
                </a>
              </div>
            </>
          </div>
        </section>
        <ProcessSections locale={locale} compact />
        <LegacyHomeLinks locale={locale} />
      </>
    ) : (
      <>
        <PageHeading
          locale={locale}
          route={route}
          title={title}
          description={description}
        />
        {route === 'services' && (
          <>
            <section class="ac-section bg-white">
              <div class="ac-container">
                <ServiceEntries locale={locale} headingLevel={2} />
              </div>
            </section>
            <PurposeNavigation locale={locale} />
          </>
        )}
        {group && (
          <>
            <section class="ac-section bg-white">
              <div class="ac-container">
                <ProductionDiagram locale={locale} groupId={group.id} />
              </div>
            </section>
            <ServiceCatalog locale={locale} groupId={group.id} />
            <PortfolioSection
              locale={locale}
              variant="summary"
              groupId={group.id}
            />
            <section class="ac-section bg-brand-50">
              <div class="ac-container route-links">
                <a href={routePath(locale, 'pricing')} class="ac-btn-outline">
                  {site.nav.pricing}
                  <Arrow />
                </a>
                <a href={routePath(locale, 'process')} class="ac-btn-outline">
                  {site.nav.process}
                  <Arrow />
                </a>
              </div>
            </section>
          </>
        )}
        {route === 'works' && (
          <PortfolioSection locale={locale} showHeading={false} />
        )}
        {route === 'pricing' && <PricingTable locale={locale} />}
        {route === 'process' && <ProcessSections locale={locale} />}
      </>
    )
  }
  <ContactBand locale={locale} />
</SiteLayout>
