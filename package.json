{
  "name": "acecore-designs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build && npm run validate:output",
    "preview": "astro preview",
    "test": "node --test tests/catalog.test.mjs",
    "validate:content": "npm test",
    "validate:output": "node scripts/validate-output.mjs",
    "format:check": "prettier . --check",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  }
}
